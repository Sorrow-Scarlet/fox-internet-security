<UserControl
	x:Class="fox_internet_security.Views.ScanView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:view="using:fox_internet_security.Views"
	xmlns:vm="using:fox_internet_security.ViewModels"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="vm:ScanViewModel"
	mc:Ignorable="d">

	<!--  右侧UI，此为扫描界面  -->
	<Grid RowDefinitions="30,*">
		<!--  标题栏区域  -->
		<Panel
			Grid.Row="0"
			Background="#80FFFFFF"
			IsHitTestVisible="False" />
		<!--  内容区域  -->
		<ScrollViewer
			Grid.Row="1"
			Padding="20"
			Background="#80FFFFFF">
			<StackPanel Margin="20">

				<!--  扫描进度  -->
				<Border
					Margin="0,0,0,20"
					Padding="15"
					Background="#80FFFFFF"
					BoxShadow="0 2 5 0 #20000000"
					CornerRadius="5">
					<StackPanel Spacing="10">
						<TextBlock
							FontSize="16"
							FontWeight="Medium"
							Foreground="#333333"
							Text="扫描状态" />
						<ProgressBar
							Height="20"
							Background="#80FFFFFF"
							CornerRadius="5"
							Foreground="{DynamicResource SystemAccentColor}"
							Value="42" />


						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Foreground="#666666" Text="正在扫描: C:\Windows\System32\drivers\..." />
							<!--  手动更新按钮  -->
							<Button
								Grid.Column="1"
								Padding="10,5"
								BorderThickness="0"
								Classes="accent"
								Content="扫描"
								CornerRadius="5"
								Foreground="White" />
						</Grid>

						<Grid ColumnDefinitions="*,*,*">
							<TextBlock
								FontSize="12"
								Foreground="#666666"
								Classes="ScanScanedFile"
								Text="已扫描: 8,542 个文件" />
							<TextBlock
								Grid.Column="1"
								FontSize="12"
								Foreground="#666666"
								Classes="ScanThreatFound"
								Text="发现威胁: 0" />
							<TextBlock
								Grid.Column="2"
								FontSize="12"
								Foreground="#666666"
								Classes="ScanTimeLeft"
								Text="剩余时间: 12分钟" />
						</Grid>

					</StackPanel>
				</Border>

				<!--  扫描结果  -->
				<Border
					Padding="15"
					Margin="0,0,0,20"
					Background="#80FFFFFF"
					BoxShadow="0 2 5 0 #20000000"
					CornerRadius="5">
					<StackPanel Spacing="10">
						<TextBlock
							FontSize="16"
							FontWeight="Medium"
							Foreground="#333333"
							Text="扫描结果" />
					
							<ListBox
								Background="Transparent"
								BorderThickness="0"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled">
								<!--  威胁项示例  -->



							
							<ListBoxItem>
								<Grid Width="400" ColumnDefinitions="Auto,*">
	
									<StackPanel Grid.Column="1">
										<TextBlock
											FontWeight="Medium"
											Foreground="#D32F2F"
											Text="检测到潜在威胁" />
										<TextBlock
											FontSize="12"
											Foreground="#999999"
											Text="C:\Users\Downloads\suspicious.exe" />
									</StackPanel>
								</Grid>
							</ListBoxItem>

							<!--  安全文件示例  -->
							<ListBoxItem>
								<Grid Width="400" ColumnDefinitions="Auto,*">

									<StackPanel Grid.Column="1">
										<TextBlock
											FontWeight="Medium"
											Foreground="#388E3C"
											Text="文件安全" />
										<TextBlock
											FontSize="12"
											Foreground="#999999"
											Text="C:\Windows\explorer.exe" />
									</StackPanel>
								</Grid>
							</ListBoxItem>
						</ListBox>
					
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>


</UserControl>
