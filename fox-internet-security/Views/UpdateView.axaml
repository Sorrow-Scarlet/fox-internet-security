<UserControl
	x:Class="fox_internet_security.Views.UpdateView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:fox_internet_security.ViewModels"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="vm:UpdateViewModel"
	mc:Ignorable="d">

	<!--  右侧UI，此为更新  -->

	<Grid RowDefinitions="30,*">
		<!--  标题栏区域  -->
		<Panel
			Grid.Row="0"
			Background="#80FFFFFF"
			IsHitTestVisible="False" />
		<!--  内容区域  -->
		<ScrollViewer
			Grid.Row="1"
			Padding="20"
			Background="#80FFFFFF">
			<StackPanel Margin="20">
				<!--  当前版本卡片  -->
				<Border
					Margin="0,0,0,20"
					Padding="15"
					Background="#80FFFFFF"
					BoxShadow="0 2 5 0 #20000000"
					CornerRadius="8">
					<Grid ColumnDefinitions="Auto,*,Auto">
						<TextBlock
							Margin="0,0,10,0"
							VerticalAlignment="Center"
							FontSize="18"
							Text="📦" />

						<StackPanel Grid.Column="1">
							<TextBlock
								FontWeight="Medium"
								Foreground="#333333"
								Text="当前版本" />
							<TextBlock
								FontSize="12"
								Foreground="#666666"
								Text="v2.3.1 (稳定版)" />
						</StackPanel>

						<!--  手动更新按钮  -->
						<Button
							Grid.Column="2"
							Padding="10,5"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							BorderThickness="0"
							Classes="accent"
							Content="更新"
							CornerRadius="4"
							Foreground="White" />
					</Grid>
				</Border>

				<!--  更新进度  -->
				<Border
					Margin="0,0,0,20"
					Padding="15"
					Background="#80FFFFFF"
					BoxShadow="0 2 5 0 #20000000"
					CornerRadius="5">
					<StackPanel Spacing="10">
						<TextBlock
							FontSize="16"
							FontWeight="Medium"
							Foreground="#333333"
							Text="更新进度" />

						<ProgressBar
							Height="20"
							Background="#80FFFFFF"
							CornerRadius="3"
							Foreground="{DynamicResource SystemAccentColor}"
							Value="65" />

						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Foreground="#666666" Text="正在下载病毒库更新..." />
							<TextBlock
								Grid.Column="1"
								Foreground="#666666"
								Text="65%" />
						</Grid>
					</StackPanel>
				</Border>

				<!--  更新历史  -->
				<Border
					Padding="15"
					Background="#80FFFFFF"
					BoxShadow="0 2 5 0 #20000000"
					CornerRadius="5">
					<StackPanel Spacing="10">
						<TextBlock
							FontSize="16"
							FontWeight="Medium"
							Foreground="#333333"
							Text="更新历史" />

						<ListBox
							Background="Transparent"
							BorderThickness="0"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ListBoxItem>
								<Grid Width="400" ColumnDefinitions="Auto,*">
									<TextBlock
										Margin="0,0,10,0"
										VerticalAlignment="Center"
										FontSize="18"
										Text="🔄" />
									<StackPanel Grid.Column="1">
										<TextBlock
											FontWeight="Medium"
											Foreground="#333333"
											Text="病毒库更新" />
										<TextBlock
											FontSize="12"
											Foreground="#999999"
											Text="2023-09-15 14:30 | 2.3MB" />
									</StackPanel>
								</Grid>
							</ListBoxItem>

							<ListBoxItem>
								<Grid Width="400" ColumnDefinitions="Auto,*">
									<TextBlock
										Margin="0,0,10,0"
										VerticalAlignment="Center"
										FontSize="18"
										Text="🔄" />
									<StackPanel Grid.Column="1">
										<TextBlock
											FontWeight="Medium"
											Foreground="#333333"
											Text="引擎更新" />
										<TextBlock
											FontSize="12"
											Foreground="#999999"
											Text="2023-09-10 09:15 | 5.7MB" />
									</StackPanel>
								</Grid>
							</ListBoxItem>

							<ListBoxItem>
								<Grid Width="400" ColumnDefinitions="Auto,*">
									<TextBlock
										Margin="0,0,10,0"
										VerticalAlignment="Center"
										FontSize="18"
										Text="🔄" />
									<StackPanel Grid.Column="1">
										<TextBlock
											FontWeight="Medium"
											Foreground="#333333"
											Text="程序更新" />
										<TextBlock
											FontSize="12"
											Foreground="#999999"
											Text="2023-09-01 16:45 | 12.1MB" />
									</StackPanel>
								</Grid>
							</ListBoxItem>
						</ListBox>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>

</UserControl>
