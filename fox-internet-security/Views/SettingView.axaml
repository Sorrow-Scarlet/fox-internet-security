<UserControl
	x:Class="fox_internet_security.Views.SettingView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:fox_internet_security.ViewModels"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="vm:SettingViewModel"
	mc:Ignorable="d">

	<!--  右侧UI，此为设置  -->

	<Grid RowDefinitions="30,*">
		<Panel
			Grid.Row="0"
			Background="#80FFFFFF"
			IsHitTestVisible="False" />

		<ScrollViewer
			Grid.Row="1"
			Background="#80FFFFFF"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="30" Spacing="20">

				<!--  自动更新设置  -->
				<Border Classes="settings-card">
					<StackPanel Spacing="15">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path
								Width="20"
								Height="20"
								Data="M19 14l-7 7m0 0l-7-7m7 7V3"
								Stretch="Uniform"
								Stroke="#202020"
								StrokeThickness="2" />
							<TextBlock
								Classes="section-title"
								FontSize="16"
								FontWeight="Medium"
								Text="[WIP]自动更新" />
						</StackPanel>
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								VerticalAlignment="Center"
								Text="自动下载并安装更新" />
							<ToggleSwitch
								Grid.Row="0"
								Grid.Column="1"
								HorizontalAlignment="Right"
								IsChecked="True" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="0,10,0,0"
								VerticalAlignment="Center"
								Text="检查更新频率" />
							<ComboBox
								Grid.Row="1"
								Grid.Column="1"
								Width="120"
								Margin="0,10,0,0"
								HorizontalAlignment="Right"
								SelectedIndex="1">
								<ComboBoxItem>每天</ComboBoxItem>
								<ComboBoxItem>每周</ComboBoxItem>
								<ComboBoxItem>每月</ComboBoxItem>
							</ComboBox>
						</Grid>
					</StackPanel>
				</Border>

				<!--  自启动设置  -->
				<Border Classes="settings-card">
					<StackPanel Spacing="15">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path
								Width="20"
								Height="20"
								Data="M13 10V3L4 14h7v7l9-11h-7z"
								Stretch="Uniform"
								Stroke="#202020"
								StrokeThickness="2" />
							<TextBlock
								Classes="section-title"
								FontSize="16"
								FontWeight="Medium"
								Text="自启动设置" />
						</StackPanel>

						<Grid ColumnDefinitions="*,Auto">
							<TextBlock VerticalAlignment="Center" Text="开机自动启动" />
							<ToggleSwitch HorizontalAlignment="Right" IsChecked="False" />
						</Grid>
					</StackPanel>
				</Border>

				<!--  扫描设设置  -->
				<Border Classes="settings-card">
					<StackPanel Spacing="15">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path
								Width="20"
								Height="20"
								Data="M120-40q-33 0-56.5-23.5T40-120v-80q0-17 11.5-28.5T80-240q17 0 28.5 11.5T120-200v80h80q17 0 28.5 11.5T240-80q0 17-11.5 28.5T200-40h-80Zm720 0h-80q-17 0-28.5-11.5T720-80q0-17 11.5-28.5T760-120h80v-80q0-17 11.5-28.5T880-240q17 0 28.5 11.5T920-200v80q0 33-23.5 56.5T840-40ZM480-220q-106 0-196-56T143-429q-6-12-9-24.5t-3-25.5q0-14 3-27t9-25q51-97 141-153t196-56q106 0 196 56t141 153q6 12 9 24.5t3 26.5q0 14-3 26.5t-9 24.5q-51 97-141 153t-196 56Zm0-120q58 0 99-41t41-99q0-58-41-99t-99-41q-58 0-99 41t-41 99q0 58 41 99t99 41Zm0-80q-25 0-42.5-17.5T420-480q0-25 17.5-42.5T480-540q25 0 42.5 17.5T540-480q0 25-17.5 42.5T480-420Zm440-420v80q0 17-11.5 28.5T880-720q-17 0-28.5-11.5T840-760v-80h-80q-17 0-28.5-11.5T720-880q0-17 11.5-28.5T760-920h80q33 0 56.5 23.5T920-840Zm-800-80h80q17 0 28.5 11.5T240-880q0 17-11.5 28.5T200-840h-80v80q0 17-11.5 28.5T80-720q-17 0-28.5-11.5T40-760v-80q0-33 23.5-56.5T120-920Z"
								Stretch="Uniform"
								Stroke="#202020"
								StrokeThickness="1.5" />
							<TextBlock
								Classes="section-title"
								FontSize="16"
								FontWeight="Medium"
								Text="[WIP]扫描设置" />
						</StackPanel>
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								VerticalAlignment="Center"
								Text="启用Yara引擎" />
							<ToggleSwitch
								Grid.Row="0"
								Grid.Column="1"
								HorizontalAlignment="Right"
								IsChecked="True" />

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="0,10,0,0"
								VerticalAlignment="Center"
								Text="启用{占位}引擎" />
							<ToggleSwitch
								Grid.Row="1"
								Grid.Column="1"
								Margin="0,10,0,0"
								HorizontalAlignment="Right"
								IsChecked="True" />
						</Grid>
					</StackPanel>
				</Border>

				<!--  VirusTotal API配置  -->
				<Border Classes="settings-card">
					<StackPanel Spacing="15">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Path
								Width="20"
								Height="20"
								Data="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
								Stretch="Uniform"
								Stroke="#202020"
								StrokeThickness="2" />
							<TextBlock
								Classes="section-title"
								FontSize="16"
								FontWeight="Medium"
								Text="[WIP]VirusTotal API配置" />
						</StackPanel>

						<Grid
							ColumnDefinitions="*,Auto"
							RowDefinitions="Auto,Auto,Auto"
							RowSpacing="10">
							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								VerticalAlignment="Center"
								Text="API密钥" />
							<TextBox
								Grid.Row="1"
								Grid.Column="0"
								PasswordChar="*"
								Watermark="输入您的API密钥" />

							<TextBox
								Grid.Row="3"
								Grid.Column="0"
								Margin="0,0,0,10"
								IsReadOnly="True"
								Text="https://www.virustotal.com/vtapi/v2/" />

							<Button
								Grid.Row="1"
								Grid.RowSpan="3"
								Grid.Column="1"
								Margin="10,0,0,0"
								VerticalAlignment="Center"
								Content="测试连接" />
						</Grid>
					</StackPanel>
				</Border>

				<!--  操作按钮  -->
				<StackPanel
					Margin="0,20,0,0"
					HorizontalAlignment="Center"
					Orientation="Horizontal"
					Spacing="15">
					<Button Classes="accent" Content="保存设置" />
					<Button Content="恢复默认" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

	</Grid>




</UserControl>
