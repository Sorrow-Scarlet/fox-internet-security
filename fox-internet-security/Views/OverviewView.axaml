<UserControl
	x:Class="fox_internet_security.Views.OverviewView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:fox_internet_security.ViewModels"
	d:DesignHeight="450"
	d:DesignWidth="800"
	x:DataType="vm:OverviewViewModel"
	mc:Ignorable="d">

	<!--  右侧UI，此为概述  -->
	<Border
		Grid.Column="1"
		Padding="20"
		Background="#80FFFFFF"
		IsHitTestVisible="False">
		<!--  LOGO & 文字  -->
		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
			<Image
				Width="100"
				Height="100"
				Source="{SvgImage /Assets/fis-logo.svg}" />
			<TextBlock
				Margin="0,20,0,0"
				HorizontalAlignment="Center"
				FontSize="24"
				Text="月狐卫" />

			<!--  时间线的背景  -->
			<Border
				Width="350"
				Margin="0,40,0,0"
				VerticalAlignment="Bottom"
				Classes="settings-card"
				CornerRadius="10">
				<!--  纵向堆叠里嵌套横向堆叠  -->
				<StackPanel>
					<StackPanel Orientation="Horizontal">
						<Label
							Classes="iconTimeLineHead"
							Content="&#xf6b8;"
							FontFamily="{DynamicResource ResourceKey=MaterialIcons}" />
						<Label
							Classes="akkoTimeLineHead"
							Content="时间线"
							FontWeight="Bold" />
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<Label
							Classes="iconTimeLineText"
							Content="&#xf4b5;"
							FontFamily="{DynamicResource ResourceKey=MaterialIcons}" />
						<Label Classes="akkoTimeLineText" Content="扫描了Test.txt" />
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<Label
							Classes="iconTimeLineText"
							Content="&#xf4b5;"
							FontFamily="{DynamicResource ResourceKey=MaterialIcons}" />
						<Label Classes="akkoTimeLineText" Content="更新了病毒库" />
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<Label
							Classes="iconTimeLineText"
							Content="&#xf4b5;"
							FontFamily="{DynamicResource ResourceKey=MaterialIcons}" />
						<Label Classes="akkoTimeLineText" Content="清空了沙盒" />
					</StackPanel>
				</StackPanel>

			</Border>
		</StackPanel>
	</Border>

</UserControl>
